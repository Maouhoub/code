{
  "name": "SwinIR_structured_pruning_chunk1",
  "model": "plain",
  "scale": 2,
  "num_gpu": 1,
  "manual_seed": 0,

  "datasets": {
    "train": {
      "name": "DIV2K",
      "type": "DatasetSR", 
      "dataroot_H": "trainsets/trainH",
      "dataroot_L": "trainsets/trainL",
      "H_size": 64,
      "dataloader_shuffle": true,
      "dataloader_num_workers": 1,
      "dataloader_batch_size": 4
    },
    "test": {
      "name": "Set5",
      "type": "DatasetSR",
      "dataroot_H": "testsets/Set5/HR",
      "dataroot_L": "testsets/Set5/LR_bicubic/X2",
      "dataloader_batch_size": 1
    }
  },

  "netG": {
    "net_type": "swinir",
    "upscale": 2,
    "in_chans": 3,
    "img_size": 64,
    "window_size": 8,
    "img_range": 1.0,
    "depths": [6, 6, 6, 6],
    "embed_dim": 60,
    "num_heads": [6, 6, 6, 6],
    "mlp_ratio": 2,
    "upsampler": "pixelshuffledirect",
    "resi_connection": "1conv"
  },

  "train": {
    "G_lossfn_type": "l1",
    "G_lossfn_weight": 1.0,
    "G_optimizer_type": "adam",
    "G_optimizer_lr": 2e-4,
    "G_optimizer_betas": [0.9, 0.99],
    "G_optimizer_wd": 0,
    "G_optimizer_clipgrad": null,
    "G_scheduler_type": "MultiStepLR",
    "G_scheduler_milestones": [50000, 100000, 200000, 300000],
    "G_scheduler_gamma": 0.5,
    "G_regularizer_orthstep": null,
    "G_regularizer_clipstep": null,
    "epochs": 5,
    "checkpoint_test": 5000,
    "checkpoint_save": 5000,
    "checkpoint_print": 200
  },

  "fine_tune": {
    "L2_ft_epochs": 3
  },

  "path": {
    "root": "superresolution",
    "pretrained_netG": null,
    "pretrained_netE": null,
    "models": "superresolution/models",
    "images": "superresolution/images",
    "log": "superresolution/log"
  }
}
